# Required for RAWG game discovery and searches.
RAWG_API_KEY="key"

# Minutes before the Steam Live Top snapshot is refreshed.
# Set to 0 to refresh on every app rerun.
PLAYER_REFRESH_MINUTES=15

# Hours before the RAWG Home popularity snapshot is refreshed.
# Independent of the Steam interval; set to 0 to refresh on every app rerun.
CATALOG_REFRESH_HOURS=24

# Optional: defaults to data/gaming_statistics.db.
# GAMING_DASHBOARD_DB=data/gaming_statistics.db
